<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" namespace="Utac.Rnc2.BusinessObjects" assembly="Utac.Rnc2.BusinessObjects">
  <class name="Utac.Rnc2.BusinessObjects.pJournalActivite" table="p_journal_activite" lazy="true">
    <id name="Id">
      <column name="journal_id" />
      <generator class="native" />
    </id>
    
    <many-to-one name="UtilisateurModification" class="rUtilisateur">
      <column name="code_utilisateur_modification" />
    </many-to-one>
    
    <many-to-one name="CentreEncour" class="pCentreEncour">
      <column name="id_centre_encours" />
    </many-to-one>
    
    <many-to-one name="ContoleurEncour" class="pContoleurEncour">
      <column name="id_controleur_encours" />
    </many-to-one>
    
    <many-to-one name="UtilisateurCreateur" class="rUtilisateur">
      <column name="code_utilisateur_createur" />
    </many-to-one>
    
    <property name="Detail">
      <column name="detail" not-null="true" />
    </property>
    
    <property name="DateCreation">
      <column name="date_creation" />
    </property>
    
    <property name="DateModification">
      <column name="date_modification" />
    </property>
    
  </class>
</hibernate-mapping>
