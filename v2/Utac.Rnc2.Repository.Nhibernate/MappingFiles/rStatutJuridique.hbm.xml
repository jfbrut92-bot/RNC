<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" namespace="Utac.Rnc2.BusinessObjects" assembly="Utac.Rnc2.BusinessObjects">
	<class name="Utac.Rnc2.BusinessObjects.rStatutJuridique, Utac.Rnc2.BusinessObjects" table="r_statut_juridique" lazy="true">
		<id name="Id" column="cod_statut_juridique">
		 	<generator class="assigned" />
		</id>
		<property name="Libelle" column="libelle" />
		<property name="OrdreAffichage" column="ordre_affichage" />
		<bag name="PCentreEncours" lazy="true" cascade="all" inverse="true" >
			<key column="cod_statut_juridique"></key>
			<one-to-many class="pCentreEncour"></one-to-many>
		</bag>
		<bag name="PCentreHistos" lazy="true" cascade="all" inverse="true" >
			<key column="cod_statut_juridique"></key>
			<one-to-many class="pCentreHisto"></one-to-many>
		</bag>
	</class>
</hibernate-mapping>

