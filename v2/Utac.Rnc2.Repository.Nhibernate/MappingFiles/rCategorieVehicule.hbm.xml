<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" namespace="Utac.Rnc2.BusinessObjects" assembly="Utac.Rnc2.BusinessObjects">
	<class name="Utac.Rnc2.BusinessObjects.rCategorieVehicule, Utac.Rnc2.BusinessObjects" table="r_categorie_vehicule" lazy="true">
		<id name="Id" column="id_categorie">
		 	<generator class="assigned" />
		</id>
		<property name="CodCategorie" column="cod_categorie" />
		<property name="LibelleCategorie" column="libelle_categorie" />
		<property name="NumTri" column="num_tri" />
		<many-to-one name="RHabilitation" column="cod_habilitation" class="rHabilitation" />
		<bag name="PAuditControleurs" lazy="true" cascade="all-delete-orphan" inverse="true" >
			<key column="id_categorie"></key>
			<one-to-many class="pAuditControleur"></one-to-many>
		</bag>
	</class>
</hibernate-mapping>

