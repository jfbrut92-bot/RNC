@model Utac.Rnc2.Pv.UI.Web.Models.RechercheCodeCentreControleurModel
@using Utac.Rnc2.UI.Web.Enums
@using Utac.Rnc2.Web.Pv.Utils;

@{ var otcIsMobileDevice = DeviceHelper.IsMobileDevice(Request.UserAgent); }

@section TitleContent {
    Recherche des PV installation/contrôleur
}

@section SousTitrePage {
    @if (otcIsMobileDevice)
    {
        @:Liste des PV d'une installation/contrôleur
    }
    else
    {
        @:Recherche des PV d'une installation/contrôleur
    }
}

@section StyleContent {
    @Styles.Render("~/styles/jquery-ui")
}

<div class="row w-100 no-gutters">
    @using (Html.BeginForm("RechercheCodeCentreControleur", "TraceRechPvVl",
        new { ReturnUrl = ViewBag.ReturnUrl },
        FormMethod.Post, new { @class = "col-12" }))
    {
        @Html.ValidationSummary(true)
        <fieldset class="row no-gutters mx-2 mx-md-0">
            <div class="row no-gutters col-12 col-md-9 mb-md-3">
                <div class="col-12 col-md-3 flex-column">
                    <label class="@(otcIsMobileDevice ? "col-form-label-sm w-100" : " ")"
                           for="SelectCategorie">
                        Catégorie du véhicule
                    </label>
                    <div class="mb-1">
                        <select id="SelectCategorie" name="CategorieValue" class="@(otcIsMobileDevice ? "form-control-sm w-100" : "w-75")" onchange="ActivateInputButton()">
                            @foreach (var item in CategorieVehicule.Values)
                            {
                                <option value="@item.Value" @(item.Ordinal == Model.Categorie.Ordinal ? "selected" : "")>@item.ToString()</option>
                            }
                        </select>
                    </div>
                    <br class="col-12 d-md-none" />
                </div>

                <div class="col-12 col-md-3 flex-column">
                    <label class="@(otcIsMobileDevice ? "col-form-label-sm" : " ")"
                           for="CodeAgrementCentre">
                        N° Agrément installation
                    </label>
                    <div class="row no-gutters mb-1">
                        @Html.TextBoxFor(model => model.CodeAgrementCentre, new { @class = otcIsMobileDevice ? "form-control-sm w-100 text-uppercase col-12 p-2 " : "w-100 text-uppercase col-12", @maxlength = otcIsMobileDevice ? "8" : "8", @onclick = "ActivateInputButton();" })
                        @Html.ValidationMessageFor(model => model.CodeAgrementCentre, null, new { @class = "col-12" })
                    </div>
                </div>
                <div class="@(otcIsMobileDevice ? "col-form-label-sm" : " ") col-12  mb-md-0 col-md-1 p-0 text-center ">
                    et/ou
                </div>
                <div class="col-12 col-md-4 flex-column">
                    <label class="@(otcIsMobileDevice ? "col-form-label-sm w-100" : " ")"
                           for="CodeAgrementControleur">
                        N° Agrément contrôleur
                    </label>
                    <div class="row @(otcIsMobileDevice ? "" : "w-75") no-gutters mb-1">
                        @Html.TextBoxFor(model => model.CodeAgrementControleur, new { @class = otcIsMobileDevice ? "form-control-sm w-100 text-uppercase col-12 p-2" : "w-75 text-uppercase col-12", @maxlength = otcIsMobileDevice ? "8" : "8", @onclick = "ActivateInputButton();" })
                        @Html.ValidationMessageFor(model => model.CodeAgrementControleur, null, new { @class = "col-12" })
                    </div>
                    <br class="col-12 d-md-none" />
                </div>
            </div>
            <div class="row col-12 no-gutters col-md-11 mb-md-3">
                <div class="col-12 col-md-3 flex-column">
                    <label class="@(otcIsMobileDevice ? "col-form-label-sm" : " ")"
                           for="DateVisiteDebut">
                        Date visite début
                    </label>
                    <div class="mb-1">
                        @Html.TextBoxFor(model => model.DateVisiteDebut, new { @Value = otcIsMobileDevice ? @Model.DateVisiteDebut.ToString("yyyy-MM-dd") : @Model.DateVisiteDebut.ToShortDateString(), type = otcIsMobileDevice ? "date" : "text", @class = otcIsMobileDevice ? "form-control-sm w-100" : "datepicker mr-2 w-75" , @onchange = "ActivateInputButton();" })
                        @Html.ValidationMessageFor(model => model.DateVisiteDebut, null, new { @class = otcIsMobileDevice ? "" : "alert-message error" })
                    </div>
                    <br class="col-12 d-md-none" />
                </div>
                <div class="col-12 col-md-3 flex-column">
                    <label class="@(otcIsMobileDevice ? "col-form-label-sm" : " ")"
                           for="DateVisiteFin">
                        Date visite fin
                    </label>
                    <div class="mb-1">
                        @Html.TextBoxFor(model => model.DateVisiteFin, new { @Value = otcIsMobileDevice ? @Model.DateVisiteFin.ToString("yyyy-MM-dd") : @Model.DateVisiteFin.ToShortDateString(), type = otcIsMobileDevice ? "date" : "text", @class = otcIsMobileDevice ? "form-control-sm w-100" : "datepicker mr-2 mr-2 w-75", @onchange = "ActivateInputButton();" })
                        @Html.ValidationMessageFor(model => model.DateVisiteFin, null, new { @class = otcIsMobileDevice ? "" : "alert-message error" })
                    </div>
                    <br class="col-12 d-md-none" />
                </div>
                <div class="col-12 col-md-2 flex-column">
                    <label class="@(otcIsMobileDevice ? "col-form-label-sm" : " ")"
                           for="SelectDetails">
                        Niveau de détails
                    </label>
                    <div class="mb-1">
                        <select id="SelectDetails"
                                name="DetailValue"
                                class="@(otcIsMobileDevice ? "form-control-sm w-100" : "")">
                            @foreach (var item in NiveauDetails.Values)
                            {
                                <option value="@item.Value" @(item.Ordinal == Model.Details.Ordinal ? "selected" : "")>@item.ToString()</option>
                            }
                        </select>
                    </div>
                    <br class="col-12 d-md-none" />
                </div>
                <div class="col-12 col-md-3 ml-md-4 mt-2 mt-md-0 p-0 row no-gutters align-items-end align-items-md-start">
                    <button type="submit"
                            id="btInput"
                            disabled
                            class="@(otcIsMobileDevice ? "btn-primary rounded-lg col-form-label-sm disabled":"btn primary disabled")  col-12 col-md-7 p-1">
                        <i class="fa fa-search text-white mr-2 d-md-none"></i>
                        Recherche
                    </button>
                    <a class="d-none d-sm-none d-md-block  btn success col-xl-4 col-lg-4 col-md-4 offset-1 p-1" id="btCancel" href="@Url.Action("RechercheCodeCentreControleur", "TraceRechPvVl")">Effacer</a>
                </div>
            </div>
        </fieldset>
    }
</div>
@if (@ViewData["message"] != null)
{
    <div id="MessageErreur" class="avertissement msg-font-size">
        @ViewData["message"]
    </div>
    <br />
    <script type="text/javascript">
        document.getElementById("btInput").onclick = function () {
            document.getElementById("MessageErreur").style.display = "none";
            document.body.style.cursor = "wait";
            document.getElementById("btInput").style.cursor = "wait";
            document.getElementById("btInput").className = "@(otcIsMobileDevice ? "btn-primary rounded-lg col-form-label-sm disabled" : "btn disabled")" + " col-12 col-md-7 p-1";
        }
        window.location.href = '#MessageErreur';
    </script>
}
else
{
<script type="text/javascript">
    document.getElementById("btInput").onclick = function () {
            //document.getElementById("btInput").setAttribute("disabled", "");
            document.body.style.cursor = "wait";
            document.getElementById("btInput").style.cursor = "wait";
            document.getElementById("btInput").className = "@(otcIsMobileDevice ? "btn-primary rounded-lg col-form-label-sm disabled" : "btn disabled")" + " col-12 col-md-7 p-1";
            document.getElementById("btCancel").style.cursor = "wait";
        }
        document.getElementById("btCancel").onclick = function () {
            document.body.style.cursor = "wait";
            document.getElementById("btCancel").style.cursor = "wait";
            document.getElementById("btInput").style.cursor = "wait";
        }
</script>
    if (ViewBag.ScrollTo != null)
    {
        <script>
            window.location.href = '@ViewBag.ScrollTo';
        </script>
    }
}
<div id="list" class="row no-gutters  px-2">
    <div class="col-12 row no-gutters">
        <div class="col-12 row no-gutters">@Html.Partial("~/Views/TraceRechPvVl/RechercheResultatVl.cshtml", Model)</div>
    </div>
    <div class="col-12 row no-gutters">
        <div class="col-12 row no-gutters">@Html.Partial("~/Views/TraceRechPvVl/RechercheResultatPl.cshtml", Model)</div>
    </div>
    <div class="col-12 row no-gutters">
        <div class="col-12 row no-gutters">@Html.Partial("~/Views/TraceRechPvVl/RechercheResultatCl.cshtml", Model)</div>
    </div>
</div>

<!--18/05/2022 PLE Permettre de nouveau le téléchargement si changement de niveau séléectionné de détail du PV -->
<script type="text/javascript">
    document.getElementById('SelectDetails').onchange = function () {
        var btns = document.getElementsByName('download_pv');
        console.log(btns.length.toString() + 'boutons');
        for (var i = 0; i < btns.length; i++) {
            if ($(window).width() < 768) {
                btns[i].className = "border-0 fa fa-download title text-primary";
            } else {
                btns[i].className = "btn success";
            }
        }
    };
    //12/02/2024 PLE réactiver le  bouton post si modification formaulaire 
    function ActivateInputButton() {
        document.getElementById("btInput").removeAttribute('disabled');
        document.getElementById("btInput").className ="@(otcIsMobileDevice ? "btn-primary rounded-lg col-form-label-sm":"btn primary")" + " col-12 col-md-7 p-1";
    }
</script>

@section JavaScriptContent {
    <!-- DatePicker -->
    @Scripts.Render("~/scripts/date-picker")
    <!-- Saisie numérique uniquement -->
    @Scripts.Render("~/scripts/saisie-numeric")
}
