<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="hibernate-configuration" type="NHibernate.Cfg.ConfigurationSectionHandler, NHibernate"/>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net"/>
  </configSections>
  <appSettings>

    <!-- Paramètres SMTP pour envoi mails -->
    <add key="smtp_host" value="smtp.utac.lan"/>
    <add key="smtp_port" value="26"/>
    <add key="smtp_auth_user" value="Email_Applis_DEV"/>
    <add key="smtp_auth_pwd" value="appliutac"/>
    <add key="from" value="noreply@utac.com"/>

    <!-- Paramètres pour le remoting , accès PKI -->
    <add key="remoting_url" value="tcp://sintradev:8085/RemoteServeurPKI"/>
    <add key="remoting_security" value="true"/>
    <add key="remoting_auth_user" value="rnc2remote"/>
    <add key="remoting_auth_pwd" value="rnc2remote"/>
    <add key="remoting_auth_domain" value="sintradev"/>
    <add key="remoting_pki_server" value="sintradev\UTACTEST"/>
    <!-- 
    <add key="temporary_folder" value="C:\\WINDOWS\\Temp" />
    -->
    
    <!-- Paramètres pour fichiers à inclure dans le zip -->
    <add key="fichier_certificat_racine_confiance" value="UTAC-OTC.cer"/>

    <!-- pour génération des mots de passe -->
    <add key="password_allowed_chars" value="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#=+.?"/>

  </appSettings>
  <hibernate-configuration xmlns="urn:nhibernate-configuration-2.2">
    <session-factory>
      <property name="connection.provider">NHibernate.Connection.DriverConnectionProvider</property>
      <property name="current_session_context_class">call</property>
      <property name="show_sql">true</property>
      <!-- Pour SQLServer -->
      <!--
      <property name="dialect">NHibernate.Dialect.MsSql2005Dialect</property>
      <property name="connection.driver_class">NHibernate.Driver.SqlClientDriver</property>
      <property name="connection.connection_string">Data Source=localhost\SQLEXPRESS;Initial Catalog=rnc2;Integrated Security=True</property>
      -->
      <!-- Fin Pour SQLServer -->
      <!-- Pour SybaseASE -->
      <property name="dialect">NHibernate.Dialect.SybaseASE15Dialect</property>
      <property name="connection.driver_class">NHibernate.Driver.SybaseAdoNet45Driver</property>
      <property name="connection.connection_string">Data Source=195.101.61.161;Port=5100;UID=appli_rnc2;PWD=appli_rnc2;Database=rnc2_net</property>
      <!--<property name="proxyfactory.factory_class">NHibernate.ByteCode.Castle.ProxyFactoryFactory, NHibernate.ByteCode.Castle</property>-->
      <!-- Fin Pour SybaseASE -->
      <!-- Pour MySQL
      <property name="dialect">NHibernate.Dialect.MySQLDialect</property>
      <property name="connection.driver_class">NHibernate.Driver.MySqlDataDriver</property>
      <property name="connection.connection_string">Database=rnc2;Data Source=localhost;User Id=root;Password=</property>
      <property name="proxyfactory.factory_class">NHibernate.ByteCode.Castle.ProxyFactoryFactory, NHibernate.ByteCode.Castle</property>
      <property name="hbm2ddl.auto">create</property>
      Fin pour MySQL -->
    </session-factory>
  </hibernate-configuration>
  <log4net>
    <appender name="GeneralLog" type="log4net.Appender.RollingFileAppender">
      <file value="D:/temp/webapp.log"/>
      <appendToFile value="true"/>
      <maximumFileSize value="100KB"/>
      <rollingStyle value="Size"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%d{HH:mm:ss} [%t] %-5p %c - %m%n"/>
      </layout>
    </appender>
    <root>
      <level value="DEBUG"/>
      <appender-ref ref="GeneralLog"/>
    </root>
    <logger name="NHibernate" additivity="false">
      <level value="DEBUG"/>
      <appender-ref ref="GeneralLog"/>
    </logger>
    <logger name="NHibernate.SQL" additivity="false">
      <level value="DEBUG"/>
      <appender-ref ref="GeneralLog"/>
    </logger>
  </log4net>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup></configuration>
