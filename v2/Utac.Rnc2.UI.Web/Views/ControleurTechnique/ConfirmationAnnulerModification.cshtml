@model Utac.Rnc2.BusinessObjects.pContoleurEncour

@section TitleContent {
    Confirmation de l'annulation de la dernière modification de la fiche du @Model.Titre @Model.Nom @Model.Prenom
}
@section SousTitrePage {
    Confirmation de l'annulation de la dernière modification de la fiche du @Model.Titre @Model.Nom @Model.Prenom
}
ATTENTION! Vous allez annuler la dernière modification effectuée sur cette fiche :
@Model.RTypeDemandeControleur.Libelle à la date du @Model.DateMiseaJour
    Cliquez sur le bouton confirmer pour continuer l'annulation
<form method="post" action="@Url.Action("AnnulerModification")">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" value="Confirmer" class="btn primary">Confirmer</button>
    <a class="btn success" href="@Url.Action("Fiche","ControleurTechnique", new { id = Model.Id})">Retour à la fiche</a>
</form>
