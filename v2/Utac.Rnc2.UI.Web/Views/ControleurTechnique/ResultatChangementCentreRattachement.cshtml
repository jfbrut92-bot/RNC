@model Utac.Rnc2.UI.Web.Models.ActionAgrementControleurModel

@section TitleContent {
    Resultat changement de centre de rattachement
}
@section SousTitrePage {
    Prise en compte du changement de centre de rattachement @Model.categorieVehicule.ToString() pour le controleur @Model.controleur.Nom @Model.controleur.Prenom
}
<p class="static-msg">La demande de rattachement @Model.categorieVehicule.ToString() pour le controleur @Model.controleur.Nom @Model.controleur.Prenom a été prise en compte</p>
<p>
    <img src="/Content/images/PDF.png" alt="Notification PDF" title="Notification PDF" />
    @Html.ActionLink("Cliquer sur ce  lien pour télécharger la notification au format PDF", "TelechargerNotificationPDF", new { id = Model.controleur.Id, categorieVehicule = Model.categorieVehicule })
</p>
<p>@Html.ActionLink("Cliquer sur ce  lien pour retourner à la fiche du contrôleur", "Fiche", new { id = Model.controleur.Id })</p>
