@model Utac.Rnc2.UI.Web.Models.ExtensionAgrementControleurCatLModel
@using Utac.Rnc2.BusinessObjects
@using Utac.Rnc2.MVC.Extensions

@section TitleContent {
    Déclaration d'extension à la catégorie L
}
@section SousTitrePage {
    Déclaration d'extension à la catégorie L de l'agrément  @Model.Categorie
    @switch (@Model.Categorie)
    {
        case rCategorieVehicule.CategorieEnum.VL:
            @:@Model.Controleur.CodAgremVl
            break;
        case rCategorieVehicule.CategorieEnum.PL:
            @:@Model.Controleur.CodAgremPl
            break;
    }
    <br />Contrôleur : @Model.Controleur.Nom @Model.Controleur.Prenom
}
@section StyleContent {
    @Styles.Render("~/styles/jquery-ui")
}
<p class="avertissement">
    Attention, la saisie des informations relatives à <strong>l'extension d'agrément catégorie L</strong>, par le réseau de rattachement ou le titulaire de l'agrément du centre non rattaché, est réalisée en application de l'article 41 de l'Arrêté du 23 octobre 2023 relatif au contrôle technique des véhicules motorisés à deux ou trois roues et quadricycles à moteur.
    <br /><br />
    Pendant cette <strong>période transitoire</strong>, le contrôleur ou son centre de rattachement ou son réseau d'affiliation dépose une demande d'agrément pour le contrôle des véhicules de catégorie L en vue de l'obtention de l'agrément avant la fin de validité de son extension d'agrément.
    <br /><br />
    Si la date de la déclaration d'extension est antérieure au 15 avril 2024, elle ne sera valide (date d'effet) qu'à compter du 15 avril 2024.
    <br /><br />
    Si la date de la déclaration d'extension est réalisée entre le 15 avril 2024 et le 14 avril 2025, elle sera valide le jour même de la déclaration.
    <br /><br />
    A compter du <strong>15 avril 2025</strong>, la déclaration d'extension n'est plus valide. Seule la délivrance d'un agrément pour le centre et le contrôleur permettra de réaliser le contrôle des véhicules de catégorie L.
</p>
@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)
    <fieldset>
        <div class="editor-label">@Html.Label("Extension d'agrément Catégorie L :")</div>
        <div class="editor-field">
            <select name="Controleur.ExtAgremClStatut">
                <option value="" @(Model.Controleur.ExtAgremClStatut == null ? "selected" : "")>---</option>
                <option value="1" @(((short?)1).Equals(Model.Controleur.ExtAgremClStatut) ? "selected" : "")>oui</option>
            </select>
            @Html.ValidationMessageFor(model => model.Controleur.ExtAgremClStatut)
        </div>
        <div class="editor-label">@Html.Label("Validitée à compter du :")</div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.Controleur.ExtAgremClDateValid, new { Value = String.Format("{0:d}", Model.Controleur.ExtAgremClDateValid), @class = "datepicker" })
            @Html.ValidationMessageFor(model => model.Controleur.ExtAgremClDateValid)
        </div>
    </fieldset>
    <br />
    <div class="rowAligne">
        <input type="submit" value="Déclarer" class="btn primary" />
        @if (String.IsNullOrEmpty(Model.ReturnLettreReseau))
        {
            @Html.ActionLink("Retour", "Fiche", new { id = Model.Controleur.Id }, new { @class = "btn cancel" })
        }
        else
        {
            @Html.ActionLink("Retour", "ReturnToListeControleurPourReseau", "Home", new { returnLettreReseau = Model.ReturnLettreReseau, returnCodDep = Model.ReturnCodDep }, new { @class = "btn cancel" })
        }
    </div>
    @Html.HiddenFor(m => m.Controleur.Id)
}
@section JavaScriptContent {
    <!-- DatePicker -->
    @Scripts.Render("~/scripts/date-picker")
}
