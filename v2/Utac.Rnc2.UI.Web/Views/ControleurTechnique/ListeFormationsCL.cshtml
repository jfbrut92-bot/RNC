@model Utac.Rnc2.BusinessObjects.pContoleurEncour
@using Utac.Rnc2.BusinessObjects
@using Utac.Rnc2.UI.Web.Helpers

@section TitleContent {
    Liste des formations CL pour le @Model.Titre @Model.Nom @Model.Prenom
}
@section SousTitrePage {
    Liste des formations CL pour le @Model.Titre @Model.Nom @Model.Prenom
}
<table>
    <tr>
        <th></th>
        <th>Type de formation</th>
        <th>
            Date début
        </th>
        <th>
            Date fin
        </th>
        <th>
            Résultat formation
        </th>
    </tr>
    @{ var i = 0; }
    @foreach (var item in Model.PFormationControleurCLs)
    {
        <tr class="@(i % 2 == 0  ? "row1" : "row2")">
            <td>
                @if (GestionDroitsExecution.canModify(this.User, new BeanModifiable<pFormationControleurCL>(item)))
                {
                    @Html.ActionLink("Modifier", "ModifierFormationCL", new { id = item.Id })
                    @:|
                    @Html.ActionLink("Supprimer", "ConfirmationDeleteFormationCL", new { id = item.Id })
                }
            </td>
            <td>
                @if (@item.RTypeFormation == null)
                {
                    @:&nbsp;
                }
                else
                {
                    @item.RTypeFormation.LibelleTypeFormation
                }
            </td>
            <td>@String.Format("{0:d}", item.DateDebut)</td>
            <td>@String.Format("{0:d}", item.DateFin)</td>
            <td>@(item.ResultatFormation ? "Favorable" : "Défavorable")</td>
        </tr>
        i++;
    }
</table>
<div>
    <br />
    @Html.ActionLink("Retour à la fiche", "Fiche", new { id = Model.Id }, new { @class = "btn success" })
</div>
