@model Utac.Rnc2.BusinessObjects.pAuditControleurCL

@section TitleContent {
    ConfirmationDeleteSanction
}
<h2>Confirmation de suppression d'un audit</h2>
<h3>Contrôleur: @Model.Controleur.Nom - @Model.Controleur.CodAgremVl @Model.Controleur.CodAgremPl @Model.Controleur.CodAgremCl </h3>
<br />
Attention veuillez confirmer la suppression de l'audit
@Model.ResultatAudit du :
@String.Format("{0:d}", Model.DateAudit)
    en cliquant sur le lien ci-dessous. Pour revenir à la liste des audits CL cliquez
@Html.ActionLink("ici", "ListeAuditsCL", new { id = Model.Controleur.Id })
<form method="post" action="@Url.Action("DeleteAuditCL")">
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="submit" value="Confirmer" />
</form>
