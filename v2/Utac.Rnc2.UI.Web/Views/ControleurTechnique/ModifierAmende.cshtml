@model Utac.Rnc2.UI.Web.Models.AjouterAmendeControleurModel

@section TitleContent {
    ModifierAmende
}
@section SousTitrePage {
    Modifier une contravention
}
@section StyleContent {
    @Styles.Render("~/styles/jquery-ui")
}
<h3>Centre: @Model.Controleur.Nom - @Model.Controleur.CodAgremVl @Model.Controleur.CodAgremPl @Model.Controleur.CodAgremCl </h3>
<br />
@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)
    <fieldset>
        <div class="editor-label">
            @Html.Label("Libellé de la contravention")
        </div>
        <div class="editor-field">
            @Html.TextAreaFor(model => model.Amende.LibContravention, new { rows = 5, cols = 50, maxlength = "800" })
            @Html.ValidationMessageFor(model => model.Amende.LibContravention)
        </div>
        <div class="editor-label">
            @Html.Label("Date d'émission")
        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.Amende.DateEmisAmende, new { Value = string.Format("{0:d}", Model.Amende.DateEmisAmende), @class = "datepicker" })
            @Html.ValidationMessageFor(model => model.Amende.DateEmisAmende)
        </div>
        @Html.HiddenFor(model => model.Controleur.Id)
        @Html.HiddenFor(model => model.Amende.Id)
        @Html.HiddenFor(model => model.Amende.PContoleurEncour.Id)
        @*<p>
                    <input type="submit" value="Enregistrer"/>
            </p> *@
        <br />
        <div class="row">
            <input type="submit" value="Enregistrer" class="btn primary" />
            <a class="btn success" href="@Url.Action("ListeAmendes","ControleurTechnique", new { id = Model.Controleur.Id})">Retour à la liste des contraventions</a>
            <a class="btn success" href="@Url.Action("Fiche","ControleurTechnique", new { id = Model.Controleur.Id})">Retour à la fiche</a>
        </div>
    </fieldset>
}
@section JavaScriptContent {
    <!-- DatePicker -->
    @Scripts.Render("~/scripts/date-picker")
}
