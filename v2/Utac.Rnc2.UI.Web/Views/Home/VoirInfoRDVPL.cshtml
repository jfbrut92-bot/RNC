@model Utac.Rnc2.BusinessObjects.rReseau

@section TitleContent {
    Informations de prise de rendez-vous PL pour le réseau @Model.Nom (@Model.Id)
}
@section SousTitrePage {
    Informations de prise de rendez-vous PL pour le réseau @Model.Nom (@Model.Id)
}
@Html.ActionLink("Retour à la page d'accueil", "Index")
<div class="editor-label">
    <label>N°de téléphone de la centrale de réservation : </label>
    @Model.PInfoRdvs[0].NumTelCentrale
</div>
<div class="editor-label">
    <label>Tarification : </label>
    @Model.PInfoRdvs[0].NumTelTarif
</div>
<div class="editor-label">
    <label>Site web : </label>
    @Model.PInfoRdvs[0].SiteWeb
</div>
<div class="editor-label">
    <label>Serveur minitel : </label>
    @Model.PInfoRdvs[0].ServeurMinitel
</div>
<a href="@Url.Action("ModifierInfoRDVPL", new { id= Model.Id})">Modifier les informations de prise de RDV</a>
