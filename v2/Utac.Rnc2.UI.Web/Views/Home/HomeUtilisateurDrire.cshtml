<a name="Liste5"></a>
<h4>Liste des centres agréés depuis le @Model.datedeb (@(Model.ListeCentreNouvellementAgree != null ? Model.ListeCentreNouvellementAgree.Count : 0))</h4>
@if (Model.ListeCentreNouvellementAgree != null)
{
    <table>
        <tr>
            <th>Raison sociale</th>
            <th>Agrément VL</th>
            <th>Agrément CL</th>
            <th>Agrément PL</th>
        </tr>
        @{ var i = 0; }
        @foreach (var item in Model.ListeCentreNouvellementAgree)
        {
            <tr class="@(i % 2 == 0 ? "row1" : "row2")">
                <td>@Html.ActionLink(item.RaisonSociale, "Fiche", "Centre", new { id = item.Id }, null)</td>
                <td>
                    @(item.EstAgrementValideVL ? item.CodAgremVl: "")
                </td>
                <td>
                    @(item.EstAgrementValideCL ? item.CodAgremCl: "")
                </td>
                <td>
                    @(item.EstAgrementValidePL ? item.CodAgremPl: "")
                </td>
            </tr>
            i++;
        }
    </table>
    <a href="#HautPage">Retour en haut de la page</a>
}
