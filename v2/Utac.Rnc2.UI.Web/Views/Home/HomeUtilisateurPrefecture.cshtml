@model Utac.Rnc2.UI.Web.Models.HomeModel

<fieldset>
    <h4>Votre préfecture : (@Model.utilisateur.RPrefecture.CodDepartement) @Model.utilisateur.RPrefecture.LibellePrefecture</h4>

    <div class="">
        Courriel :
        @if (Model.utilisateur.Email != null)
        {
            @Model.utilisateur.Email
        }
        else
        {
            <b>Aucune adresse n'est enregistrée! </b>
        }
        @*
        <a class="btn success" href="@Url.Action("ModifierAdresseMail","Home",new { id=Model.utilisateur.Id })">Modifier</a>
        *@
    </div>
    @*
    @Html.ActionLink("Obtenir un nouveau mot de passe", "RenewPassword0", "Information")
    *@
    <br /><a href="#Liste1">Personnes de votre région disposant d'un accès actif à RNC2</a>
    <br /><a href="#Liste2">Liste des contrôleurs agréés dont le centre de rattachement (VL) est fermé</a>
    <br /><a href="#Liste11">Liste des contrôleurs agréés dont le centre de rattachement (CL) est fermé</a>
    <br /><a href="#Liste3">Liste des contrôleurs agréés dont le centre de rattachement (PL) est fermé</a>
    <br /><a href="#Liste5">Liste des contrôleurs en attente d'agrément</a>
    <br /><a href="#Liste6">Liste des centres en attente d'agrément</a>
    <br /><a href="#Liste7">Liste des derniers contrôleurs agréés</a>
    <br /><a href="#Liste9">Liste des contrôleurs agrées sans centre de rattachement</a>
    <br /><a href="#Liste8">Liste des derniers centres agréés</a>
    <br /><a href="#Liste10">Liste des prestataires Européens</a>
    <br />
</fieldset>
<a name="Liste1"></a>
<h4>Personnes de votre département disposant d'un accès actif à RNC2</h4>
@if (Model.ListeAutresUtilisateurs != null)
{
    <table>
        <tr>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Identifiant</th>
        </tr>
        @{ var i = 0; }
        @foreach (var item in Model.ListeAutresUtilisateurs)
        {
            if (item.Actif == true)
            {
                <tr class="@(i % 2 == 0 ? "row1" : "row2")">
                    <td>@item.Nom</td>
                    <td>@item.Prenom</td>
                    <td>@item.Id</td>
                </tr>
                i++;
            }
        }
        <tfoot><tr><td colspan="4"><a href="#HautPage">Retour en haut de la page</a></td></tr></tfoot>
    </table>

}
<a name="Liste2"></a>
<h4>Liste des contrôleurs agréés dont le centre de rattachement est fermé</h4>
<h3>Contrôleurs VL (@(Model.ListeControleurAgreeCentreFermeVL != null ? Model.ListeControleurAgreeCentreFermeVL.Count : 0))</h3>
@if (Model.ListeControleurAgreeCentreFermeVL != null && Model.ListeControleurAgreeCentreFermeVL.Count>0)
{
    <table>
        <tr>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Agrément</th>
            <th>Centre rattachement</th>
        </tr>
        @{ var i = 0; }
        @foreach (var item in Model.ListeControleurAgreeCentreFermeVL)
        {
            <tr class="@(i % 2 == 0 ? "row1" : "row2")">
                <td>@item.Nom</td>
                <td>@item.Prenom</td>
                <td>@Html.ActionLink(item.CodAgremVl, "Fiche", "ControleurTechnique", new { id = item.Id }, null)</td>
                <td>@Html.ActionLink(item.CodAgremRattachementVl, "Fiche", "Centre", new { id = item.PCentreEncourVL.Id }, null)</td>
            </tr>
            i++;
        }
        <tfoot><tr><td colspan="4"><a href="#HautPage">Retour en haut de la page</a></td></tr></tfoot>
    </table>
}
