<a name="Liste9"></a>
@{ int nbControleursAgreesSansCentreRattachement = Model.ListeControleurAgreeSansCentreRattachementVL.Count + Model.ListeControleurAgreeSansCentreRattachementCL.Count + Model.ListeControleurAgreeSansCentreRattachementPL.Count; }
@* Désactivation CL + Model.ListeControleurAgreeSansCentreRattachementCL.Count;*@
<h4>Liste contrôleurs agréés sans centre de rattachement  (@nbControleursAgreesSansCentreRattachement)</h4>
@if (nbControleursAgreesSansCentreRattachement > 0)
{
<table>
    <tr>
        <th>Nom</th>
        <th>Prénom</th>
        <th>Agrément</th>
    </tr>
    @{ var i = 0; }
    @foreach (var item in Model.ListeControleurAgreeSansCentreRattachementVL)
    {
        <tr class=" @(i % 2 == 0 ? "row1" : "row2")">
            <td>@Html.ActionLink(item.Nom, "Fiche", "ControleurTechnique", new { id = item.Id }, new { })</td>
            <td>@item.Prenom</td>
            <td>
                @item.CodAgremVl
            </td>
        </tr>
        i++;
    }
    @foreach (var item in Model.ListeControleurAgreeSansCentreRattachementCL)
    {
        <tr class=" @(i % 2 == 0 ? "row1" : "row2")">
            <td>@Html.ActionLink(item.Nom, "Fiche", "ControleurTechnique", new { id = item.Id }, new { })</td>
            <td>@item.Prenom</td>
            <td>
                @item.CodAgremCl
            </td>
        </tr>
        i++;
    }
    @foreach (var item in Model.ListeControleurAgreeSansCentreRattachementPL)
    {
        <tr class=" @(i % 2 == 0 ? "row1" : "row2")">
            <td>@Html.ActionLink(item.Nom, "Fiche", "ControleurTechnique", new { id = item.Id }, new { })</td>
            <td>@item.Prenom</td>
            <td>
                @item.CodAgremPl
            </td>
        </tr>
        i++;
    }
    <tfoot><tr><td colspan="4"><a href="#HautPage">Retour en haut de la page</a></td></tr></tfoot>
</table>

}
<a name="Liste8"></a>
<h4>Liste des derniers centres agréés (@(Model.ListeCentreNouvellementAgree != null ? Model.ListeCentreNouvellementAgree.Count() : 0))</h4>
@if (Model.ListeCentreNouvellementAgree != null)
{
    <table>
        <tr>
            <th>Raison sociale</th>
            <th>Code postale / Ville</th>
            <th colspan="3">Agrément(s) / Date(s) notification </th>
        </tr>
        @{ var i = 0; }
        @foreach (var item in Model.ListeCentreNouvellementAgree)
        {
            <tr class=" @(i % 2 == 0 ? "row1" : "row2")">
                <td>@Html.ActionLink(item.RaisonSociale, "Fiche", "Centre", new { id = item.Id }, new { })</td>
                <td>@item.CpCentre  @item.Ville</td>

                @if (item.EstAgrementValideVL)
                {
                    <td>
                        VL: @item.CodAgremVl @string.Format("{0:d}", item.DateEffetNotificationVl)
                        <br />
                    </td>
                }
                else
                {
                    <td></td>
                }
                @if (item.EstAgrementValidePL)
                {
                    <td>
                        PL: @item.CodAgremPl @string.Format("{0:d}", item.DateEffetNotificationPl)
                        <br />
                    </td>
                }
                else
                {
                    <td></td>
                }
                @if (item.EstAgrementValideCL)
                {
                    <td>CL: @item.CodAgremCl @string.Format("{0:d}", item.DateEffetNotificationCl)</td>
                }
                else
                {
                    <td></td>
                }
            </tr>
            i++;
        }
        <tfoot><tr><td colspan="4"><a href="#HautPage">Retour en haut de la page</a></td></tr></tfoot>
    </table>

}
