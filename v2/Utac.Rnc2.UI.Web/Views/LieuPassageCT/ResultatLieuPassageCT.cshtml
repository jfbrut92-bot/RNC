@model Utac.Rnc2.UI.Web.Models.LieuPassageCTModel

@{ Layout = "~/Views/Shared/_SiteExterneLayout.cshtml"; }
@section TitleContent {
    ResultatLieuPassageCT
}
<fieldset style="margin: 0px; padding: 10px">
    @Html.Label("N° de la demande : ")@DateTime.Now.Year.ToString()/@Model.NumChrono
    &nbsp;&nbsp;
    <span style="white-space:nowrap">@Html.Label("Date de la demande : ")</span>
    <span style="white-space:nowrap">@String.Format("{0:dd/MM/yyyy HH:mm}", Model.DateRecherche)</span>
    <br />
    <br />
    <div>
        @Html.Label("Immatriculation : ")
        <span style="white-space:nowrap">@Model.NumImmat</span>&nbsp;&nbsp;
        <span style="white-space:nowrap">@Html.Label("N° de série : ")</span>
        <span style="white-space:nowrap">@Model.NumSerie</span>
    </div>
    <div>
        @Html.Label("Date de première immatriculation : ")
        @String.Format("{0:d}", Model.DatePremImmat)
    </div>
</fieldset>
