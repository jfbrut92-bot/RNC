                </tr>
            </table>
        </div>
        <div class="floatLeft">
            <table>
                <tr>
                    <th>Adresse</th>
                </tr>
                <tr>
                    <td>
                        <div style="width:200px">
                            <div>@Model.Centre.L1Adresse</div>
                            <div>@Model.Centre.L2Adresse</div>
                            <span>@Model.Centre.CpCentre</span>
