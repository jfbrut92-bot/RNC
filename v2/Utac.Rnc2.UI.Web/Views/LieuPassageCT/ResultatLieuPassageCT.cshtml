                    <td>
                        @Model.Centre.CodAgremVl
                        <br />
                        @if (Model.Centre.EtatAgrementVl == "1" || Model.Centre.EtatAgrementVl == "2")
                        {
                            @:(centre ouvert)
                        }
                        else
                        {
                            @:(centre fermé)
                        }
