@model IEnumerable<Utac.Rnc2.BusinessObjects.statistiques.ItemListeDesControleurs>
@{ Layout = null; }
Nom Contrôleur;Agrément Pl;Date Notification Pl;Date Naissance;Etat Agrement Pl;Qualification Pl;Date Qualification Pl;Departement;Préfecture;Région;Agrément Centre Rattachement;Raison Sociale;Adresse 1;Adresse 2;Code Postal;Ville
@foreach (var item in Model)
{
@:@($"{item.Nom} {item.Prenom}");@item.AgrementControleur;@item.DateEffetNotification;@item.DateNaissance;@item.EtatAgrementCntlr;@item.QualificationPL;@item.DateQualificationPl;="@item.CodeDepartement";@item.Prefecture;@item.Region;@item.AgrementCentreRattachement;@item.RaisonSociale;@item.Adresse1;@item.Adresse2;@item.CodePostal;@item.Ville
}
