@model Utac.Rnc2.UI.Web.Models.CertificatModel

@section TitleContent {
    Révocation du certificat SSL du Réseau de contrôle technique @($"{Model.Reseau.Nom}({@Model.Reseau.Id})")
}
@section SousTitrePage {
    Révocation du certificat SSL du Réseau de contrôle technique @($"{Model.Reseau.Nom}({@Model.Reseau.Id})")
}
<p class="avertissement">
    Attention, vous allez révoquer le certificat électronique du réseau de contrôle technique @($"{Model.Reseau.Nom}({@Model.Reseau.Id})") <br />
    Choisissez le type de révocation souhaité et cliquez sur le bouton "Révoquer" pour continuer
</p>
@using (Html.BeginForm())
{
    <input type="hidden" name="id" value="@Model.Reseau.Id" />
    @:Avec autorisation de renouvellement:
    <input type="radio" name="AutorisationRenew" value="true" checked="checked" />
    <br />
    @:Sans autorisation de renouvellement:
    <input type="radio" name="AutorisationRenew" value="false" />
    <br />
    <p>
        <input type="submit" value="Révoquer" class="btn primary" />
        <a class="btn cancel" href="@Url.Action("ListeOperationReseau", new { id = Model.Reseau.Id })">Retour</a>
    </p>
}
