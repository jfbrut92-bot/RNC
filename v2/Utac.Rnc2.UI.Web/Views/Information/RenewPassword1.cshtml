@model Utac.Rnc2.UI.Web.Models.InformationPersonelle

@section TitleContent {
    Renouvellement mot de passe
}
@section SousTitrePage {
    Renouvellement du mot de passe d'accès (étape 1/2)
}
@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)
    <div class="row">
        <div class="floatLeft first">
            @Html.Label("Vérifiez votre Adresse de Messagerie")
            <div class="input">
                @Html.TextBoxFor(model => model.Email, new { Size = 80, Maxlength = 80 })
                @Html.ValidationMessageFor(model => model.Email)
            </div>
        </div>
    </div>
    <br />
    <div class="rowAligne">
        <a class="btn success" href="@Url.Action("RenewPassword0","Information")">Etape précédente</a>
        <input type="submit" value="Etape Suivante" class="btn primary" />
    </div>
}
@section JavaScriptContent {
    @Scripts.Render("~/scripts/renew-password")
}
