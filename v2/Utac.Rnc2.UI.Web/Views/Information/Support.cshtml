@model Utac.Rnc2.UI.Web.Models.InformationPersonelle
@using Utac.Rnc2.BusinessObjects

@section TitleContent {
    Support
}

<h2>Procédure RNC2 :  Déclaration extension agréments Catégorie L</h2>
<fieldset id="manuel">
    <ul>
        <li>
            Télécharger la procédure :
            <a target="_blank"
               href="../../Content/ressources/Procédure RNC2 - déclaration extension agréments catégorie L V2.pdf"
               title="Cliquez sur le fichier avec le bouton droit de la souris et choisissez l'option Enregistrer Sous ...">
                Procédure RNC2 - déclaration extension agréments catégorie L V2.pdf
            </a>
        </li>
    </ul>
</fieldset>
@if (User.IsInRole(rUtilisateur.Profil.PREFECTURE.ToString()) || User.IsInRole(rUtilisateur.Profil.DRIRE.ToString()) || User.IsInRole(rUtilisateur.Profil.DSCR.ToString()) || User.IsInRole(rUtilisateur.Profil.OTC.ToString()))
{
    <h2>Manuel d'utilisation du RNC2 - Préfectures et organismes chargés de la surveillance - Version du 19/01/2017</h2>
