@model dynamic

@section TitleContent {
    Renouvellement mot de passe
}
@section SousTitrePage {
    Renouvellement du mot de passe d'accès (étape 2/2)
}
@if (ViewData["erreur"] != null)
{
    <span>ERREUR: @ViewData["erreur"]</span>
}
<form method="post">
    <div class="row">
        <div class="floatLeft first">
            @Html.Label("Saisir votre mot de passe actuel")
            <div class="input">
                <input type="password" value="" name="motPasse" id="motPasse" />
            </div>
        </div>
    </div>
    <br />
    <div class="rowAligne">
        <a class="btn success" href="@Url.Action("RenewPassword1","Information")">Etape précédente</a>
        <input type="submit" value="Terminer" class="btn primary" />
    </div>
</form>
