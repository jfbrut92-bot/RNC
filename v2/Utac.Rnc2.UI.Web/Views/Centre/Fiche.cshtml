@model Utac.Rnc2.UI.Web.Models.FicheModel
@using Utac.Rnc2.MVC.Extensions
@using Utac.Rnc2.BusinessObjects
@using Utac.Rnc2.UI.Web.Helpers
@using Utac.Rnc2.UI.Web.Utils

@section TitleContent {
    Fiche Installationerogation
}
@section SousTitrePage {
    @switch (Model.Centre.TypeCentre)
    {
        case "S":
            @:Fiche centre spécialisé
            <br />
            <span class="">@Model.Centre.RaisonSociale</span>
            break;
        case "A":
            @:Fiche installation auxiliaire
            <br />
            <span class="titre">@Model.Centre.RaisonSociale</span>
            break;
    }
}

@section SideBarDroite {
    <div class="sidebar-box inline-block row no-gutters">
        <ul class="sections col-11">
            @if (User.IsInRole(rUtilisateur.Profil.OTC_Administration.ToString()) || User.IsInRole(rUtilisateur.Profil.PREFECTURE.ToString()) || User.IsInRole(rUtilisateur.Profil.DRIRE.ToString()) || User.IsInRole(rUtilisateur.Profil.DSCR.ToString()) || User.IsInRole(rUtilisateur.Profil.PIV.ToString()))
            {
                <li class="section w-100 row no-gutters">
                    <h3 class="col-12 py-1">Editions</h3>
                    <div class="content-sidebar border-top-0 py-3 px-2 col-12">
                        <ul class="w-100">
                            @if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.TELECHARGE_FICHE_CENTRE))
                            {
                                <li>@Html.SecuredActionLink("Fiche", "TelechargeFichePDF", new { id = Model.Centre.Id })</li>
                            }
                        </ul>
                    </div>
                    <span class="clear col-12">&nbsp;</span>
                </li>
            }
            @* Limiter les action de modifications aux centres de la préfécture en connectée*@
            @if (GestionDroitsExecution.isRightModificationCentre(User, Model.Centre))
            {
                <li class="section w-100 row no-gutters">
                    <h3 class="col-12 py-1">Modifications</h3>
                    <div class="content-sidebar border-top-0 py-3 px-2 col-12">
                        <ul class="w-100">
                            @if (Model.NouveauCentre == null)
                            {
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.CHDECOM))
                                {
                                    <li>@Html.SecuredActionLink("Dénomination sociale", "ModificationDenominationSociale", new { id = Model.Centre.Id })</li>
                                }
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.CHREPLEG))
                                {
                                    <li>@Html.SecuredActionLink("Représentant légal", "ModificationRepresentantLegal", new { id = Model.Centre.Id })</li>
                                }
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.MODAUTRE))
                                {
                                    <li>@Html.SecuredActionLink("Autre modification ou correction", "AutreModification", new { id = Model.Centre.Id })</li>
                                }
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.RETOUR))
                                {
                                    if (!Model.Centre.RMotifModification.Id.Equals("CRECEVL") && !Model.Centre.RMotifModification.Id.Equals("CRECEPL") && !Model.Centre.RMotifModification.Id.Equals("CRECECL") && !Model.Centre.RMotifModification.Id.Equals("RETOUR"))
                                    {
                                        <li>@Html.SecuredActionLink("Retour arrière", "ConfirmationModificationRetourArriere", new { id = Model.Centre.Id, deleteHisto = "false" })</li>
                                    }
                                }
                            }
                        </ul>
                    </div>
                    <span class="clear col-12">&nbsp;</span>
                </li>
            }
            <li class="section w-100 row no-gutters">
                <h3 class="col-12 py-1">Agrément VL</h3>
