                                }
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.NOTVL))
                                {
                                    <li>@Html.SecuredActionLink("Notification d'agrément", "NotificationAgrement", new { id = Model.Centre.Id, categVehicule = rCategorieVehicule.CategorieEnum.VL })</li>
                                }
                                break;
                            case "5": //AGREMENT_RENOUVELE_OK}
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.ANUVL))
                                {
                                    <li>@Html.SecuredActionLink("Annuler l'agrément", "AnnulerAgrement", new { id = Model.Centre.Id, categVehicule = rCategorieVehicule.CategorieEnum.VL })</li>
                                }
                                break;
                            case "6": //AGREMENT_RENOUVELE_REJETE}
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.DEAVL))
                                {
                                    <li>@Html.SecuredActionLink("Demande d'agrément", "DemandeAgrement", new { id = Model.Centre.Id, categVehicule = rCategorieVehicule.CategorieEnum.VL })</li>
                                }
                                break;
                        }
                        @if (GestionDroitsExecution.isRightImpNotification(User, Model.Centre, rCategorieVehicule.CategorieEnum.VL))
                        {
                            if ("A".Equals(Model.Centre.TypeCentre))
                            {
                                <li>@Html.SecuredActionLink("Editer la notification", "TelechargerNotificationAuxiliairePDF", new { id = Model.Centre.Id, categVehicule = rCategorieVehicule.CategorieEnum.VL })</li>
                            }
                            else
                            {
                                <li>@Html.SecuredActionLink("Editer la notification", "TelechargerNotificationSpecialisePDF", new { id = Model.Centre.Id, categVehicule = rCategorieVehicule.CategorieEnum.VL })</li>
                            }
                        }
                        @if (GestionDroitsExecution.isRightImpModifNotification(User, Model.Centre, rCategorieVehicule.CategorieEnum.VL))
                        {
                            <li>@Html.SecuredActionLink("Editer la notification", "ChoixTelechargerModifNotificationPDF", new { id = Model.Centre.Id })</li>
                        }
                        @if ((User.IsInRole(rUtilisateur.Profil.OTC_Administration.ToString()) || User.IsInRole(rUtilisateur.Profil.OTC_Consultation.ToString())) && Model.Centre.CodAgremVl != null)
                        {
                            <li>
                                @{var nbFactures = 0; }
                                @if (Model.Centre.ReseauRattachementVL.Id == Convert.ToString(rReseau.IdCodeReseau.Z))
                                {
                                    nbFactures = Model.Centre.PFactures.Count;
                                }
                                else
                                {
                                    nbFactures = Model.Centre.ReseauRattachementVL.PFactures.Count;
                                }
                                @if (nbFactures > 0)
                                {
                                    if (Model.Centre.ReseauRattachementVL.Id == Convert.ToString(rReseau.IdCodeReseau.Z))
                                    {
                                        <!--: Html.SecuredActionLink("Liste des factures", "listeFactureCentre", new { id = Model.Centre.Id, categorie = rCategorieVehicule.CategorieEnum.VL })-->
                                        <!-- 29/09/2014 Appel direct du controleur FACTURE -->
                                        @Html.SecuredActionLink("Liste des factures", "listeFactureCentre", "Facture", new { id = Model.Centre.Id, categorie = rCategorieVehicule.CategorieEnum.VL })
                                    }
                                    else
                                    {
                                        @Html.SecuredActionLink("Liste des factures", "listeFactureReseau", "Facture", new { id = Model.Centre.ReseauRattachementVL.Id })
                                    }
                                }
                                else
                                {
                                    @:Liste des factures(0)
                                }
                            </li>
                        }
                    </ul>
                </div>
                <span class="clear col-12">&nbsp;</span>
            </li>

