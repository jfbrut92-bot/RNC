                                {
                                    <li>@Html.SecuredActionLink("Demande d'agrément", "DemandeAgrement", new { id = Model.Centre.Id, categVehicule = rCategorieVehicule.CategorieEnum.VL })</li>
                                }
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.NOUVEL_AGREM_VL))
                                {
                                    <li>@Html.SecuredActionLink("Nouvel agrément", "NouvelAgrement", new { id = Model.Centre.Id, categVehicule = rCategorieVehicule.CategorieEnum.VL })</li>
                                }
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.TELECHARGE_CE_VL))
                                {
                                    <li>@Html.SecuredActionLink("Téléchargement rapport d'exceptions", "ListeRapportException", "Centre", new { id = Model.Centre.Id, categorie = rCategorieVehicule.CategorieEnum.VL })</li>
                                }
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.TELECHARGE_CERTIF_SSL_VL))
                                {
                                    <li>@Html.SecuredActionLink("Téléchargement du certificat électronique", "ListeOperationCentreNonRattache", "PKI", new { id = Model.Centre.Id, categorie = rCategorieVehicule.CategorieEnum.VL })</li>
                                }
                                break;
                            case "1": //AGREMENT_OK
                                      //PLE le 23/01 Prise en compte agrément catégorie L
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.EXTDECLA_VL))
                                {
                                    <li>@Html.SecuredActionLink("Déclarer extension agrément Cat.L", "DeclarerExtensionAgrementCatL", new { id = Model.Centre.Id, categorie = rCategorieVehicule.CategorieEnum.VL })</li>
                                }
                                //PLE le 23/01 Prise en compte agrément catégorie L
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.EXTRETRA_VL))
                                {
                                    <li>@Html.SecuredActionLink("Retirer extension agrément Cat.L", "RetirerExtensionAgrementCatL", new { id = Model.Centre.Id, categorie = rCategorieVehicule.CategorieEnum.VL })</li>
                                }
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.ANUVL))
                                {
                                    <li>@Html.SecuredActionLink("Annuler l'agrément", "AnnulerAgrement", new { id = Model.Centre.Id, categVehicule = rCategorieVehicule.CategorieEnum.VL })</li>
                                }
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.TELECHARGE_CE_VL))
                                {
                                    <li>@Html.SecuredActionLink("Téléchargement rapport d'exceptions", "ListeRapportException", "Centre", new { id = Model.Centre.Id, categorie = rCategorieVehicule.CategorieEnum.VL })</li>
                                }
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.EQUIPVL))
                                {
                                    <li>
                                        @Html.SecuredActionLink((Model.Centre.EquipementCentreVLs.Count == 0 ? "Renseigner" : "Voir") + " équipements spéc. / Contrôle GAZ" + ("A".Equals(Model.Centre.TypeCentre) ? " / Stockage PV " : ""), Model.Centre.EquipementCentreVLs.Count == 0 ? "CreateEquipementSpecifiqueVL" : "VoirEquipementSpecifiqueVL", new { id = Model.Centre.Id })
                                    </li>
                                }
                                else
                                {
                                    if (Model.Centre.EquipementCentreVLs.Count > 0 && GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.SHOW_EQUIPVL))
                                    {
                                        <li>
                                            @Html.SecuredActionLink("Voir équipements spécifiques / Contrôle GAZ", "VoirEquipementSpecifiqueVL", new { id = Model.Centre.Id })
                                        </li>
                                    }
                                }
