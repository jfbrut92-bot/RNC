    <div class="bloc_principal  col-12 row no-gutters">
        @if (Model.NouveauCentre != null)
        {
            <div class="static-msg col-12 p-2 pl-md-5">
                ATTENTION, il existe une fiche plus récente pour ce centre suite à un nouvel agrément.
                <br />
                Pour accéder à cette fiche cliquer @Html.ActionLink("ici", "Fiche", new { id = Model.NouveauCentre.Id })
            </div>
        }
        else
        {
            if (Model.Centre.PCentreEncourPrecedent != null)
            {
                <div class="static-msg col-12 d-flex flex-column p-2 @(DeviceHelper.IsMobileDevice(Request.UserAgent)? "text-justify":"pl-5")">
                    <span>Une ancienne fiche existe pour ce centre avant la demande d'un nouvel agrément.<br />
                    En accédant à l'ancienne fiche en cliquant
                    <span><b>
                        @Html.ActionLink("ici", "Fiche", new { id = Model.Centre.PCentreEncourPrecedent.Id })</b>, vous pourrez:
                    </span>
                    </span>
                    <ul class="w-100 pl-4">
                        <li>Vérifier l'existence de contrôleurs encore rattachés à un ancien agrément</li>
                        <li>Consulter l'ancien historique des actions effectuées sur ce centre.</li>
                    </ul>
