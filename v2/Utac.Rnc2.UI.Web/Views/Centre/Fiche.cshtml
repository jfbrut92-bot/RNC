                                }
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.DEROG_VL))
                                {
                                    <li>
                                        @Html.SecuredActionLink("Ajouter une dérogation", "AjouterDerogation", new { id = Model.Centre.Id, categorie = rCategorieVehicule.CategorieEnum.VL })
                                    </li>
                                }
                                break;
                            case "2": //AGREMENT_DEMANDE_EN_COURS}
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.REJVL))
                                {
                                    <li>@Html.SecuredActionLink("Rejet de la demande", "RejetAgrement", new { id = Model.Centre.Id, categVehicule = rCategorieVehicule.CategorieEnum.VL })</li>
                                }
                                if (GestionDroitsExecution.isRightActionForCentre(User, Model.Centre, GestionDroitsExecution.ActionsFicheCentre.NOTVL))
                                {
                                    <li>@Html.SecuredActionLink("Notification d'agrément", "NotificationAgrement", new { id = Model.Centre.Id, categVehicule = rCategorieVehicule.CategorieEnum.VL })</li>
                                }
                                break;
                            case "3": //AGREMENT_REJETE}
