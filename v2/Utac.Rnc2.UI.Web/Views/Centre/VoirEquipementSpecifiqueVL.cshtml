@model Utac.Rnc2.BusinessObjects.pCentreEncour
@using Utac.Rnc2.UI.Web.Helpers

@section TitleContent {
    Visualisation des équipements spécifiques VL pour le centre @Model.RaisonSociale
}
@section SousTitrePage {
    Visualisation des équipements spécifiques VL pour le centre @Model.RaisonSociale
}
<div class="editor-label">Contrôle des véhicules GAZ : @(Model.EquipementCentreVLs[0].ControleVehiculeGaz ? "oui" : "non")</div>
<div class="editor-label">
    Contrôle des véhicules à transmission : @(Model.EquipementCentreVLs[0].ControleVehiculeTransmissionSpecifique ? "oui" : "non")
</div>
<div class="editor-label">Equipement rouleau fou : @(Model.EquipementCentreVLs[0].EquipementRouleauFou ? "oui" : "non")</div>
<div class="editor-label">Décéléromètre : @(Model.EquipementCentreVLs[0].Decelerometre ? "oui" : "non")</div>
<div class="editor-label"> Banc à rotation inversé : @(Model.EquipementCentreVLs[0].BancRotationInverse ? "oui" : "non")</div>
@if ("A".Equals(Model.TypeCentre))
{
    <div class="editor-label">Lieu de stockage : @Model.EquipementCentreVLs[0].LieuStockagePV</div>
}
<br />
@if (GestionDroitsExecution.isRightActionForCentre(User, Model, GestionDroitsExecution.ActionsFicheCentre.EQUIPVL))
{
    <a class="btn primary" href="@Url.Action("ModifierEquipementSpecifiqueVL","Centre", new { id = Model.Id})">Modifier équipements spécifiques</a>
}
<a class="btn success" href="@Url.Action("Fiche","Centre", new { id = Model.Id})">Retour à la fiche</a>
