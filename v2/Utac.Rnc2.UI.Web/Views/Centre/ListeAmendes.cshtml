@model Utac.Rnc2.BusinessObjects.pCentreEncour
@using Utac.Rnc2.UI.Web.Helpers

@section TitleContent {
    ListeAmendes
}
@section SousTitrePage {
    Liste des contraventions
}
<h3>Installation: @Model.RaisonSociale - @Model.CodAgremVl @Model.CodAgremPl @Model.CodAgremCl</h3>
<br />
<table>
    <tr>
        <th></th>
        <th>Libellé contravention</th>
        <th>Date émission</th>
    </tr>
    @{ var i = 0; }
    @foreach (var item in Model.PAmendeCentres)
    {
        <tr class="@(i % 2 == 0 ? "row1" : "row2")">
            <td>
                @if (GestionDroitsExecution.isRightActionForCentre(User, Model, GestionDroitsExecution.ActionsFicheCentre.AMEND))
                {
                    @Html.ActionLink("Modifier", "ModifierAmende", new { id = item.Id }) @( "|") @Html.ActionLink("Supprimer", "ConfirmationDeleteAmende", new { id = item.Id })
                }
            </td>
            <td>@item.LibContravention</td>
            <td>@String.Format("{0:d}", item.DateEmisAmende)</td>
        </tr>
        i++;
    }
</table>
@* Propager le paramètre du formulaire précédent*@
@Html.HiddenFor(model => model.RaisonSociale)
@Html.HiddenFor(model => model.Id)
@Html.HiddenFor(model => model.CodAgremVl)
@Html.HiddenFor(model => model.CodAgremPl)
@Html.HiddenFor(model => model.CodAgremCl)
<p>
    <a class="btn success" href="@Url.Action("Fiche","Centre", new { id = Model.Id})">Retour à la fiche</a>
</p>
